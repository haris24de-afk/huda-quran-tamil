{
  "project_name": "Huda Quran",
  "version": "1.0",
  "translator": "Haris",
  "surahs": [
    {
      "surah_number": 1,
      "surah_name": "அல்-ஃபாத்திஹா (தோற்றுவாய்)",
      "verses": [
        {
          "verse_number": 1,
          "translation": "பேரருளாளன் பேரன்புடையோன் அல்லாஹ்வின் பெயரால்."
        },
        {
          "verse_number": 2,
          "translation": "புகழ் அனைத்தும் அகிலத்தாரின் அதிபதி அல்லாஹ்வுக்கே."
        },
        {
          "verse_number": 3,
          "translation": "அவன் பேரருளாளன் பேரன்புடையோன்."
        },
        {
          "verse_number": 4,
          "translation": "தீர்ப்பு நாளின் அதிபதி."
        },
        {
          "verse_number": 5,
          "translation": "உன்னையே நாங்கள் வணங்குகிறோம்; உன்னிடமே உதவியும் தேடுகிறோம்."
        },
        {
          "verse_number": 6,
          "translation": "நீ எங்களை நேர்வழியில் நடத்துவாயாக!"
        },
        {
          "verse_number": 7,
          "translation": "அது நீ எவர்களுக்கு அருள் புரிந்தாயோ அவ்வழி; உன் கோபத்துக்கு ஆளானோர் வழியோ, இன்னும் நெறி தவறியோர் வழியோ அல்ல."
        }
      ]
    }
  ]
}
